#!/bin/bash
# Updates the OpenBot container of one Compose stack on a VPS, as a person asks in the app. See
# docs/docker.md#updates-from-the-app-on-a-vps-pokebots.
#
# The host downloads new images by itself, and installs one only when the owner or an admin presses
# Install in Server Settings > Updates:
#
# - openbot-vps-update-stage.timer runs `stage`: it pulls IMAGE_REF and, when that image is a newer
#   build than the container, writes "<version> <commit> <commit time>" to status/staged.ready.
# - The app writes an empty request file to the requests folder, which the container can write.
#   openbot-vps-update.path sees it and runs `request` as root. `update-stage` stages now, and
#   `update-install` also installs: it stops the container, copies the last changes of its data
#   volume to the mirror, makes the container again from the staged image, and waits until it is
#   online. When it does not come back, it restores the data from the mirror and the old image.
#   An install takes the image that staged.ready names, without a new download, so the app installs
#   the build that its update window shows.
#
# The mirror is a copy of the data volume next to the backups. While a staged build waits, a
# background job copies the volume to the mirror with rsync while the server runs ("pre-copy"). The
# app stops its work before it asks for the install, so the install does only a short final sync
# with the container stopped. That copy is consistent, also for SQLite with its -wal and -shm files.
# It leaves out the node_modules folders in agent folders (AGENT_PACKAGES): they hold most of the
# files, and only a package manager that an agent runs writes them. After the install, a background
# job copies them to the mirror, compresses the mirror to one archive and keeps the newest
# BACKUP_KEEP archives. Download caches are not copied (see BACKUP_EXCLUDES).
#
# The container never gets the Docker socket. Root only tests a request file and removes it; it never
# reads or follows it. Root reports in the status folder, which the container mounts read-only.
#
# Compose runs the local tag openbot-vps:current (compose.update.yaml), never IMAGE_REF itself, so a
# pull or a `docker compose up -d` by hand never changes the image. Only an install moves the tag.
#
#   openbot-vps-update setup [--recreate]   Installs the units, folders and Compose file (as root).
#   openbot-vps-update stage                Pulls and stages a newer build.
#   openbot-vps-update request              Acts on the requests of the app (the path unit runs it).
#   openbot-vps-update install              Installs the staged build now, as an Install in the app.
#   openbot-vps-update precopy              Fills the mirror while the server runs (a background job).
#   openbot-vps-update archive              Archives a stopped mirror (a background job).
#   openbot-vps-update status               Shows the running and the staged build.
set -euo pipefail
umask 077

CONFIG=${OPENBOT_VPS_UPDATE_CONFIG:-/etc/openbot-vps-update.env}
# shellcheck disable=SC1090 # Root owns the file; `setup` writes it.
if [ -r "$CONFIG" ]; then . "$CONFIG"; fi

DOCKER=${DOCKER:-docker}
STACK_DIR=${STACK_DIR:-/srv/stacks/openbot}
COMPOSE_SERVICE=${COMPOSE_SERVICE:-openbot}
CONTAINER_NAME=${CONTAINER_NAME:-openbot-openbot-1}
IMAGE_REF=${IMAGE_REF:-ghcr.io/stevmolina/pokebots:latest}
CURRENT_TAG=${CURRENT_TAG:-openbot-vps:current}
PREVIOUS_TAG=${PREVIOUS_TAG:-openbot-vps:previous}
UPDATE_DIR=${UPDATE_DIR:-/var/lib/openbot-vps-update}
REQUESTS=$UPDATE_DIR/requests
STATUS=$UPDATE_DIR/status
HOST=$UPDATE_DIR/host
BACKUP_DIR=${BACKUP_DIR:-/home/ubuntu/backups}
BACKUP_NAME=${BACKUP_NAME:-openbot}
BACKUP_KEEP=${BACKUP_KEEP:-3}
VOLUME_DIR=${VOLUME_DIR:-}
HEALTH_TIMEOUT_SECONDS=${HEALTH_TIMEOUT_SECONDS:-300}
# Each poll of a starting container asks it for its status. A short poll sees it online sooner.
POLL_SECONDS=${POLL_SECONDS:-0.25}
LOCK_FILE=${LOCK_FILE:-/run/openbot-vps-update.lock}
UNIT_DIRECTORY=${UNIT_DIRECTORY:-/etc/systemd/system}
INSTALLED=/usr/local/sbin/openbot-vps-update
# The mirror of the data volume. Root only: it holds the same secrets as the volume.
MIRROR_DIR=${MIRROR_DIR:-$BACKUP_DIR/openbot-$BACKUP_NAME-mirror}
MIRROR_DATA=$MIRROR_DIR/data
MIRROR_STATE=$MIRROR_DIR/state
MIRROR_LOCK=$UPDATE_DIR/mirror.lock
MIRROR_JOB=$UPDATE_DIR/mirror.job
# A pre-copy runs again when the mirror is older than this, while a staged build waits.
MIRROR_REFRESH_SECONDS=${MIRROR_REFRESH_SECONDS:-600}
# The disk must keep this much free space after a copy to the mirror.
MIRROR_MIN_FREE_BYTES=${MIRROR_MIN_FREE_BYTES:-1073741824}
# A stopped copy runs one rsync for each folder in SPLIT_ROOT/<agent>/ and for each other folder at
# the root of the volume, SYNC_JOBS at once (copy_tree).
SPLIT_ROOT=OpenBot/Agents
SYNC_JOBS=${SYNC_JOBS:-$(nproc 2>/dev/null || echo 4)}

# The node_modules folders in agent folders. A stopped copy (the final sync, a restore) leaves them
# out, and keeps them where it copies to. They are about 1.2 million of the 1.5 million files of the
# Personal VPS, and the walk over them was 5 of the 7 s of a final sync. OpenBot never writes them,
# so an install and a rollback do not change them; only a package manager that an agent runs does.
# The mirror keeps them: the pre-copy copies them, and after an install the archive job copies them
# before it compresses the mirror. "p" lets rsync delete a folder that only they keep in it.
AGENT_PACKAGES="-p /$SPLIT_ROOT/**/node_modules/"

# Folders that the backup does not copy, from the root of the data volume (rsync patterns). Each one
# is only a download or build cache: the tool downloads or makes it again when it is missing. User
# data stays in the backup: agent folders (also their node_modules), databases, provider-state and
# provider-runtimes, sessions, the .claude, .codex, .grok, .gemini and .cursor folders, the browser
# profiles in Partitions (logins and cookies), and Service Worker storage. A rollback restores the
# mirror with these patterns, so it keeps the caches that are on the volume. Add a folder only when
# it is surely a cache.
BACKUP_EXCLUDES=(
  /.bun/install/cache/   # Bun package downloads; `bun install` gets them again.
  /.npm/_cacache/        # npm package downloads.
  /.npm/_npx/            # Packages that npx downloaded.
  /.npm/_logs/           # npm debug logs.
  /.cache/ms-playwright/ # Playwright browser downloads; `playwright install` gets them again.
  /.cache/electron/      # Electron downloads.
  /.cache/zig/           # Zig build cache.
  /.cache/mesa_shader_cache/
  /.cache/cursor-compile-cache/
  /.cache/fontconfig/
  /.cargo/registry/      # Crate downloads and their unpacked sources.
  /.rustup/downloads/
  /.rustup/tmp/
  # Chromium caches of OpenBot and of the browser profiles in Partitions. Not "Service Worker".
  /.config/OpenBot/Cache/
  "/.config/OpenBot/Code Cache/"
  /.config/OpenBot/GPUCache/
  /.config/OpenBot/GPUPersistentCache/
  /.config/OpenBot/DawnWebGPUCache/
  /.config/OpenBot/DawnGraphiteCache/
  /.config/OpenBot/GrShaderCache/
  /.config/OpenBot/ShaderCache/
  '/.config/OpenBot/Partitions/*/Cache/'
  '/.config/OpenBot/Partitions/*/Code Cache/'
  '/.config/OpenBot/Partitions/*/GPUCache/'
  '/.config/OpenBot/Partitions/*/DawnWebGPUCache/'
  '/.config/OpenBot/Partitions/*/DawnGraphiteCache/'
  '/.config/OpenBot/Partitions/*/GrShaderCache/'
  '/.config/OpenBot/Partitions/*/ShaderCache/'
)

# The log goes to stderr, so that a function can print its result on stdout. systemd keeps both.
log() {
  printf '[%s] [openbot-vps-update] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2
}

fail() {
  log "ERROR: $*"
  exit 1
}

set_state() {
  printf '%s\n' "$2" >"$1.new"
  chmod 0644 "$1.new"
  mv -f "$1.new" "$1"
}

lock() {
  exec 9>"$LOCK_FILE"
  flock 9
}

compose() {
  (cd "$STACK_DIR" && "$DOCKER" compose "$@")
}

# "<version>|<commit>|<commit time>" of an image or a container. Docker prints "<no value>" for a
# missing label.
labels() {
  "$DOCKER" inspect --format \
    '{{index .Config.Labels "org.opencontainers.image.version"}}|{{index .Config.Labels "org.opencontainers.image.revision"}}|{{index .Config.Labels "org.opencontainers.image.created"}}' \
    "$1" 2>/dev/null || true
}

# The release version of a label, such as 0.73.0 for 0.73.0-custom. Empty when it is not one.
release_version() {
  if [[ $1 =~ ^([0-9]+\.[0-9]+\.[0-9]+)(-[A-Za-z0-9.]+)?$ ]]; then echo "${BASH_REMATCH[1]}"; fi
}

valid_revision() {
  [[ $1 =~ ^[0-9a-f]{7,40}$ ]]
}

valid_created() {
  [[ $1 =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]]
}

# Version $1 is newer than version $2.
version_newer() {
  [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" = "$1" ]
}

# True when build "$1 $2 $3" (version, commit, time) is newer than build "$4 $5 $6". An older
# OpenBot cannot open a database that a newer one migrated, so a build is newer only when it surely
# is: a newer version; or the same version, another commit and a later commit time. A running image
# without a time is older than each image with one, because the label came after it. The app uses
# the same rule (isNewerServerBuild in src/main/hosted-update-adapter.ts).
newer_build() {
  local version=$1 revision=$2 created=$3 running_version=$4 running_revision=$5 running_created=$6
  [ -n "$version" ] && [ -n "$running_version" ] || return 1
  if [ "$version" != "$running_version" ]; then
    version_newer "$version" "$running_version"
    return
  fi
  valid_revision "$revision" && [ "$revision" != "$running_revision" ] || return 1
  valid_created "$created" || return 1
  valid_created "$running_created" || return 0
  [[ $created > $running_created ]]
}

# Splits the output of `labels` into BUILD_VERSION, BUILD_REVISION and BUILD_CREATED.
read_build() {
  local version revision created
  IFS='|' read -r version revision created <<<"$1"
  BUILD_VERSION=$(release_version "$version")
  BUILD_REVISION=""
  BUILD_CREATED=""
  if valid_revision "$revision"; then BUILD_REVISION=$revision; fi
  if valid_created "$created"; then BUILD_CREATED=$created; fi
}

container_image() {
  "$DOCKER" inspect --format '{{.Image}}' "$CONTAINER_NAME" 2>/dev/null || true
}

container_running() {
  [ "$("$DOCKER" inspect --format '{{.State.Running}}' "$CONTAINER_NAME" 2>/dev/null || true)" = true ]
}

image_id() {
  "$DOCKER" image inspect --format '{{.Id}}' "$1" 2>/dev/null || true
}

read_status() {
  "$DOCKER" exec "$CONTAINER_NAME" curl -fsS --max-time 5 \
    --unix-socket /run/openbot/control.sock http://localhost/v1/status 2>/dev/null || true
}

status_value() {
  printf '%s\n' "$1" | awk -F= -v k="$2" '$1 == k { sub(/^[^=]*=/, ""); print; exit }'
}

# The folder of the /data volume of the container on the host.
volume_dir() {
  if [ -n "$VOLUME_DIR" ]; then
    echo "$VOLUME_DIR"
    return
  fi
  "$DOCKER" inspect --format '{{range .Mounts}}{{if eq .Destination "/data"}}{{.Source}}{{end}}{{end}}' \
    "$CONTAINER_NAME" 2>/dev/null || true
}

# Pulls IMAGE_REF and writes it to staged.ready when it is a newer build than the container.
# Each run writes the state again, so a staged image that is no longer newer goes away. While a
# build is staged, it starts the pre-copy job, which keeps the mirror less than
# MIRROR_REFRESH_SECONDS old. With $1 = 0 it does not: an install follows at once.
stage() {
  local precopy=${1:-1} pulled_id running_id status server
  "$DOCKER" pull --quiet "$IMAGE_REF" >/dev/null || fail "The image $IMAGE_REF did not download."
  pulled_id=$(image_id "$IMAGE_REF")
  running_id=$(container_image)
  [ -n "$pulled_id" ] || fail "The image $IMAGE_REF cannot be read."
  if [ -z "$running_id" ]; then
    rm -f "$STATUS/staged.ready"
    log "There is no container $CONTAINER_NAME, so nothing is staged."
    return 0
  fi
  # An install checks that the new container is online only when this one was.
  if container_running; then
    status=$(read_status)
    server=$(status_value "$status" server)
    if [ -n "$server" ]; then set_state "$HOST/server-state" "$server"; fi
  fi
  if [ "$pulled_id" = "$running_id" ]; then
    rm -f "$STATUS/staged.ready"
    return 0
  fi
  if [ -f "$HOST/failed-image" ] && [ "$(cat "$HOST/failed-image")" = "$pulled_id" ]; then
    rm -f "$STATUS/staged.ready"
    log "Skipping $pulled_id: an install of it failed. A newer image clears this."
    return 0
  fi
  read_build "$(labels "$CONTAINER_NAME")"
  local running_version=$BUILD_VERSION running_revision=$BUILD_REVISION running_created=$BUILD_CREATED
  read_build "$(labels "$pulled_id")"
  if newer_build "$BUILD_VERSION" "$BUILD_REVISION" "$BUILD_CREATED" \
    "$running_version" "$running_revision" "$running_created"; then
    set_state "$HOST/staged-image" "$pulled_id"
    set_state "$STATUS/staged.ready" "$BUILD_VERSION $BUILD_REVISION $BUILD_CREATED"
    log "Staged $BUILD_VERSION ${BUILD_REVISION:-?} (${BUILD_CREATED:-no time}); running $running_version ${running_revision:-?} (${running_created:-no time})."
    if [ "$precopy" = 1 ] && container_running && mirror_stale; then start_job precopy; fi
  else
    rm -f "$STATUS/staged.ready"
    log "Not staged: $IMAGE_REF is $BUILD_VERSION ${BUILD_REVISION:-?} (${BUILD_CREATED:-no time}), not newer than $running_version ${running_revision:-?} (${running_created:-no time})."
  fi
}

# The complete backups of this stack, newest first.
complete_backups() {
  local file name
  for file in "$BACKUP_DIR"/openbot-"$BACKUP_NAME"-*; do
    name=${file##*/}
    if [[ $name =~ ^openbot-${BACKUP_NAME}-[0-9]{8}T[0-9]{6}Z\.(tgz|tar\.zst)$ ]]; then echo "$name"; fi
  done | sort -r
}

# Keeps the newest $1 complete backups of this stack and deletes the others.
prune_backups() {
  local keep=$1 index=0 name
  while IFS= read -r name; do
    index=$((index + 1))
    if [ "$index" -gt "$keep" ]; then
      rm -f -- "$BACKUP_DIR/$name" "$BACKUP_DIR/$name.sha256"
      log "Deleted the old backup $name."
    fi
  done < <(complete_backups)
}

# Milliseconds since the epoch, for the times of the install phases.
now_ms() {
  date +%s%3N
}

# Seconds with one decimal, from milliseconds.
seconds() {
  printf '%d.%d' $(($1 / 1000)) $(($1 % 1000 / 100))
}

free_bytes() {
  df --block-size=1 --output=avail "$1" | tail -n 1 | tr -d ' '
}

# The options of each rsync between the data volume and the mirror. rsync copies a file when
# its size or its modification time differs. --modify-window=-1 compares the time in nanoseconds;
# with the default, rsync compares whole seconds, and the final sync could keep an old copy of a
# database page that changed in the same second as the pre-copy. Like the tar archives before, the
# copy does not keep ACLs or extended attributes: OpenBot does not use them, and they make each copy
# slower.
RSYNC_OPTIONS=(--archive --hard-links --numeric-ids --one-file-system --delete --modify-window=-1)

# The folders in each agent folder (SPLIT_ROOT/<agent>/<folder>) of $1, relative to it, each followed
# by a NUL. Each one is a "unit" of a split copy.
split_units() {
  if [ -d "$1/$SPLIT_ROOT" ]; then (cd "$1" && find "$SPLIT_ROOT" -mindepth 2 -maxdepth 2 -type d -print0); fi
}

# The other folders at the root of $1 (.config, .local, ...), each followed by a NUL: units of a split
# copy too. A name with a pattern character of rsync stays in the rest.
top_units() {
  find "$1" -mindepth 1 -maxdepth 1 -type d ! -name "${SPLIT_ROOT%%/*}" ! -name '*[[*?\\]*' -printf '%P\0'
}

# The node_modules folders of the agent folders of $1, relative to it, each followed by a NUL. Not the
# ones in another node_modules folder.
agent_packages() {
  if [ -d "$1/$SPLIT_ROOT" ]; then (cd "$1" && find "$SPLIT_ROOT" -mindepth 2 -type d -name node_modules -prune -print0); fi
}

# Copies folder $1 to folder $2 with the patterns of BACKUP_EXCLUDES. Each cache in $2 stays: the
# patterns protect it from --delete. $3 is "live" while the container runs: then a file can change
# or go away while rsync reads it, and the next copy copies it again.
#
# A stopped copy (the final sync, a restore) is downtime. rsync uses one CPU, and one rsync over the
# 1.5 million files of the Personal VPS takes 43 s, most of them in the node_modules of agent
# folders. So it leaves out AGENT_PACKAGES, and runs one rsync for each unit (split_units,
# top_units) and one for the rest, SYNC_JOBS at once: 2.7 s there, from 7.4 s with them and no
# top_units. Each unit rsync starts at the root of the volume (--relative and "/./"), so the patterns
# apply as in the rest. A live copy runs one rsync over all files, which also keeps hard links
# between units.
copy_tree() {
  local from=$1 to=$2 mode=$3 pattern unit result=0 failures
  local excludes=() top=() rest=()
  local -A units=()
  for pattern in "${BACKUP_EXCLUDES[@]}"; do excludes+=("--exclude=$pattern"); done
  if [ "$mode" = live ]; then
    rsync "${RSYNC_OPTIONS[@]}" "${excludes[@]}" --stats -- "$from/" "$to/" |
      awk '/^Number of regular files transferred|^Total transferred file size/ { print "  " $0 }' >&2 ||
      result=$?
    if [ "$result" -eq 24 ]; then result=0; fi
    [ "$result" -eq 0 ] || log "rsync of $from to $to ended with code $result."
    return "$result"
  fi
  while IFS= read -r -d '' unit; do units[$unit]=1; done < <(split_units "$from")
  while IFS= read -r -d '' unit; do top+=("$unit"); done < <(top_units "$from")
  # A unit that is only in $2: the rsync of the rest cannot delete it, because its pattern protects it.
  # A node_modules unit stays, as AGENT_PACKAGES keeps it. A folder at the root that is only in $2 is
  # not a pattern of the rest, so the rest deletes it.
  while IFS= read -r -d '' unit; do
    if [ -z "${units[$unit]:-}" ] && [ "${unit##*/}" != node_modules ]; then rm -rf -- "${to:?}/$unit"; fi
  done < <(split_units "$to")
  rest=("${excludes[@]}" "--exclude=/$SPLIT_ROOT/*/*/*")
  for unit in "${top[@]}"; do rest+=("--exclude=/$unit/"); done
  failures=$(mktemp)
  { rsync "${RSYNC_OPTIONS[@]}" "--filter=$AGENT_PACKAGES" "${rest[@]}" -- "$from/" "$to/" ||
    echo "rest: rsync code $?" >>"$failures"; } &
  for unit in "${top[@]}" "${!units[@]}"; do
    while [ "$(jobs -rp | wc -l)" -ge "$SYNC_JOBS" ]; do wait -n || true; done
    { rsync "${RSYNC_OPTIONS[@]}" --relative "--filter=$AGENT_PACKAGES" "${excludes[@]}" -- "$from/./$unit/" "$to/" ||
      echo "$unit: rsync code $?" >>"$failures"; } &
  done
  wait
  if [ -s "$failures" ]; then
    log "The copy of $from to $to failed: $(head -n 3 "$failures" | tr '\n' ' ')"
    result=1
  fi
  rm -f -- "$failures"
  return "$result"
}

# Copies the data volume $1 to the mirror. $2 is "live" while the container runs, or "stopped". The
# caller holds the mirror lock.
sync_mirror() {
  local data=$1 mode=$2 need=0 available
  [ -d "$data" ] || { log "The data folder $data is not there."; return 1; }
  install -d -m 0700 "$MIRROR_DIR"
  if [ ! -d "$MIRROR_DATA" ]; then need=$(du -sb --one-file-system "$data" | cut -f 1); fi
  need=$((need + MIRROR_MIN_FREE_BYTES))
  available=$(free_bytes "$MIRROR_DIR")
  if [ "$available" -le "$need" ]; then
    log "The mirror needs about $((need / 1048576)) MiB in $MIRROR_DIR, which has $((available / 1048576)) MiB free."
    return 1
  fi
  set_state "$MIRROR_STATE" "partial $(date +%s)"
  copy_tree "$data" "$MIRROR_DATA" "$mode"
}

# Replaces the stopped data volume $1 with the mirror. The caches on the volume stay.
restore_mirror() {
  local data=$1
  [ -d "$data" ] && [ -d "$MIRROR_DATA" ] || { log "The data folder or the mirror is not there."; return 1; }
  copy_tree "$MIRROR_DATA" "$data" stopped
}

# "<state> <unix time> [<stamp>]" of the mirror: partial, live (after a pre-copy) or stopped (after
# the final sync of the stopped container at <stamp>).
mirror_state() {
  cat "$MIRROR_STATE" 2>/dev/null || true
}

# Seconds since the last complete copy to the mirror, or "never".
mirror_age() {
  local state at
  read -r state at _ <<<"$(mirror_state)"
  if [ -d "$MIRROR_DATA" ] && { [ "${state:-}" = live ] || [ "${state:-}" = stopped ]; } &&
    [[ ${at:-} =~ ^[0-9]+$ ]]; then
    echo $(($(date +%s) - at))
  else
    echo never
  fi
}

# True when the mirror has no complete copy, or one older than MIRROR_REFRESH_SECONDS.
mirror_stale() {
  local age
  age=$(mirror_age)
  [ "$age" = never ] || [ "$age" -ge "$MIRROR_REFRESH_SECONDS" ]
}

# Takes the mirror lock on file descriptor 8. With "stop-jobs", it stops a background job that holds
# it: a pre-copy or an archive has no use when an install makes a new copy.
mirror_lock() {
  local deadline=$((SECONDS + 30)) pid kind
  exec 8>"$MIRROR_LOCK"
  if flock -n 8; then return 0; fi
  [ "${1:-}" = stop-jobs ] || return 1
  while [ "$SECONDS" -lt "$deadline" ]; do
    read -r pid kind <"$MIRROR_JOB" 2>/dev/null || true
    # Only a job of this script. The job leads its process group, with rsync or tar in it.
    if [[ ${pid:-} =~ ^[0-9]+$ ]] && grep -qF openbot-vps-update "/proc/$pid/cmdline" 2>/dev/null; then
      log "Stopping the ${kind:-mirror} job ($pid): the install makes a new copy."
      kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    fi
    if flock -w 2 8; then return 0; fi
  done
  return 1
}

# A background job uses the CPU and the disk only when the server does not.
lower_priority() {
  renice -n 19 -p $$ >/dev/null 2>&1 || true
  ionice -c 3 -p $$ >/dev/null 2>&1 || true
}

# Starts `openbot-vps-update $1` (precopy or archive) in the background. systemd stops each process
# of a oneshot unit when the unit ends, so the job gets its own transient unit. Without systemd (the
# E2E check), it runs in its own session. It never keeps the locks of the caller.
start_job() {
  local kind=$1 self=${SELF:-$(readlink -f "$0")}
  if [ -d /run/systemd/system ] && command -v systemd-run >/dev/null; then
    systemd-run --quiet --collect --unit="openbot-vps-update-$kind" --property=Nice=19 \
      --property=IOSchedulingClass=idle --setenv=OPENBOT_VPS_UPDATE_CONFIG="$CONFIG" "$self" "$kind" \
      >/dev/null 2>&1 || log "The $kind job did not start. It can be running already."
  else
    OPENBOT_VPS_UPDATE_CONFIG=$CONFIG setsid nohup "$self" "$kind" </dev/null >>"$UPDATE_DIR/$kind.log" 2>&1 8>&- 9>&- &
  fi
}

# Compresses the mirror to BACKUP_DIR/openbot-<BACKUP_NAME>-<stamp $1>.tar.zst (or .tgz), with a
# .sha256 file, and keeps the newest BACKUP_KEEP archives. Prints its path.
make_archive() {
  local stamp=$1 archive need available newest compressor=(gzip -1) extension=tgz
  install -d -m 0755 "$BACKUP_DIR"
  rm -f -- "$BACKUP_DIR"/openbot-"$BACKUP_NAME"-*.partial
  # The new archive is the last one of BACKUP_KEEP, so the disk needs room for one archive only.
  prune_backups $((BACKUP_KEEP > 1 ? BACKUP_KEEP - 1 : 1))
  newest=$(complete_backups | head -n 1)
  if [ -n "$newest" ]; then
    need=$(stat --format=%s "$BACKUP_DIR/$newest")
  else
    need=$(du -sb --one-file-system "$MIRROR_DATA" | cut -f 1)
  fi
  need=$((need + need / 4 + 536870912))
  available=$(free_bytes "$BACKUP_DIR")
  [ "$available" -gt "$need" ] ||
    fail "The archive needs about $((need / 1048576)) MiB in $BACKUP_DIR, which has $((available / 1048576)) MiB free."
  if command -v zstd >/dev/null; then
    compressor=(zstd --quiet --threads=0 -3)
    extension=tar.zst
  fi
  archive=$BACKUP_DIR/openbot-$BACKUP_NAME-$stamp.$extension
  tar --create --file=- --directory="$MIRROR_DATA" --numeric-owner --sparse --one-file-system . |
    "${compressor[@]}" >"$archive.partial" || { rm -f -- "$archive.partial"; fail "The archive of the mirror failed."; }
  sync --file-system "$archive.partial"
  mv -f -- "$archive.partial" "$archive"
  (cd "$BACKUP_DIR" && sha256sum -- "${archive##*/}") >"$archive.sha256"
  prune_backups "$BACKUP_KEEP"
  echo "$archive"
}

# Copies the node_modules folders of the agent folders of the running volume $1 to the mirror, which
# a stopped copy left out (AGENT_PACKAGES), and deletes the ones that are only in the mirror. The
# other files of the mirror stay as the stopped copy made them. The container runs, so this is a live
# copy. A folder whose agent folder is not in the mirror waits for the next pre-copy.
copy_agent_packages() {
  local from=$1 folder result=0
  [ -d "$from" ] && [ -d "$MIRROR_DATA" ] || return 0
  while IFS= read -r -d '' folder; do
    if [ ! -d "$from/$folder" ]; then rm -rf -- "${MIRROR_DATA:?}/$folder"; fi
  done < <(agent_packages "$MIRROR_DATA")
  while IFS= read -r -d '' folder; do
    [ -d "$MIRROR_DATA/${folder%/*}" ] || continue
    rsync "${RSYNC_OPTIONS[@]}" -- "$from/$folder/" "$MIRROR_DATA/$folder/" || result=$?
    if [ "$result" -eq 24 ]; then result=0; fi
    [ "$result" -eq 0 ] || { log "rsync of $folder to the mirror ended with code $result."; return "$result"; }
  done < <(agent_packages "$from")
}

# Makes the archive of a stopped mirror that has none. The mirror lock is held.
archive_stopped_mirror() {
  local state at stamp started archive took data
  read -r state at stamp <<<"$(mirror_state)"
  [ "${state:-}" = stopped ] && [[ ${stamp:-} =~ ^[0-9]{8}T[0-9]{6}Z$ ]] || return 0
  if complete_backups | grep -q "^openbot-$BACKUP_NAME-$stamp\."; then return 0; fi
  started=$(now_ms)
  data=$(volume_dir)
  if [ -n "$data" ]; then
    copy_agent_packages "$data" || fail "The copy of the agent node_modules folders failed. The next job tries again."
    log "Copied the agent node_modules folders to the mirror in $(seconds $(($(now_ms) - started))) s."
  fi
  archive=$(make_archive "$stamp")
  took=$(seconds $(($(now_ms) - started)))
  log "Archived the mirror of $stamp to $archive ($(du -h "$archive" | cut -f 1)) in $took s."
  printf '{"at":"%s","result":"archived","seconds":%s,"archive":"%s"}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$took" "$archive" >>"$HOST/archives.log"
}

# The `archive` job: the archive of the copy that the last install made.
archive_job() {
  mirror_lock || { log "Another mirror job is running."; return 0; }
  printf '%s archive\n' "$$" >"$MIRROR_JOB"
  lower_priority
  archive_stopped_mirror
}

# The `precopy` job: copies the data volume to the mirror while the server runs, when the mirror is
# older than MIRROR_REFRESH_SECONDS. A stopped mirror without an archive is archived first.
precopy_job() {
  local data started
  mirror_lock || { log "Another mirror job is running."; return 0; }
  printf '%s precopy\n' "$$" >"$MIRROR_JOB"
  lower_priority
  archive_stopped_mirror
  mirror_stale || return 0
  data=$(volume_dir)
  [ -n "$data" ] || fail "The data volume of $CONTAINER_NAME is not known."
  log "Pre-copy of $data to $MIRROR_DATA while the server runs."
  started=$(now_ms)
  sync_mirror "$data" live || fail "The pre-copy failed. The next one tries again."
  set_state "$MIRROR_STATE" "live $(date +%s)"
  log "Pre-copy done in $(seconds $(($(now_ms) - started))) s."
}

# Waits until the container runs image $1 and answers its status, and is online when $2 is 1.
wait_healthy() {
  local image=$1 online=$2 deadline=$((SECONDS + HEALTH_TIMEOUT_SECONDS)) status
  while [ "$SECONDS" -lt "$deadline" ]; do
    if container_running && [ "$(container_image)" = "$image" ]; then
      status=$(read_status)
      if [ -n "$(status_value "$status" version)" ] &&
        { [ "$online" = 0 ] || [ "$(status_value "$status" server)" = online ]; }; then
        return 0
      fi
    fi
    sleep "$POLL_SECONDS"
  done
  return 1
}

check_compose() {
  local images
  images=$(compose config --images 2>/dev/null || true)
  printf '%s\n' "$images" | grep -qxF "$CURRENT_TAG" ||
    fail "Compose in $STACK_DIR does not run $CURRENT_TAG. Run 'openbot-vps-update setup' first."
}

# Installs the staged image. The lock is held. The container has stopped its work: the app runs its
# shutdown before it asks for the install, so each second from here on is downtime. The pre-copy
# filled the mirror before, while the server ran; here only the final sync runs.
install_staged() {
  local staged_id running_id data online=0 old_previous from to stamp result phases
  local t_stop t_stopped t_synced t_started t_online
  staged_id=$(cat "$HOST/staged-image" 2>/dev/null || true)
  running_id=$(container_image)
  [ -n "$staged_id" ] && [ -n "$running_id" ] || fail "There is no staged image or no container."
  check_compose
  data=$(volume_dir)
  [ -n "$data" ] || fail "The data volume of $CONTAINER_NAME is not known."
  command -v rsync >/dev/null || fail "rsync is not installed. Run 'apt-get install rsync'."
  if [ "$(cat "$HOST/server-state" 2>/dev/null || true)" = online ]; then online=1; fi
  read_build "$(labels "$running_id")"
  from="$BUILD_VERSION ${BUILD_REVISION:-?}"
  read_build "$(labels "$staged_id")"
  to="$BUILD_VERSION ${BUILD_REVISION:-?}"
  if ! mirror_lock stop-jobs; then
    "$DOCKER" restart --time 60 "$CONTAINER_NAME" >/dev/null || true
    fail "A background copy holds the mirror and did not stop. $CONTAINER_NAME runs $from again."
  fi
  log "Installing $to over $from. The mirror is $(mirror_state | cut -d ' ' -f 1) from $(mirror_age) s ago."

  old_previous=$(image_id "$PREVIOUS_TAG")
  "$DOCKER" tag "$running_id" "$PREVIOUS_TAG"
  t_stop=$(now_ms)
  "$DOCKER" stop --time 60 "$CONTAINER_NAME" >/dev/null
  t_stopped=$(now_ms)
  log "Stopped $CONTAINER_NAME in $(seconds $((t_stopped - t_stop))) s. Final sync to the mirror."
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  if ! sync_mirror "$data" stopped; then
    "$DOCKER" start "$CONTAINER_NAME" >/dev/null || true
    fail "The final sync failed, so nothing changed. $CONTAINER_NAME runs $from again."
  fi
  set_state "$MIRROR_STATE" "stopped $(date +%s) $stamp"
  t_synced=$(now_ms)
  log "Final sync in $(seconds $((t_synced - t_stopped))) s. Starting $to."
  "$DOCKER" tag "$staged_id" "$CURRENT_TAG"
  result=rolled-back
  if compose up -d --pull never "$COMPOSE_SERVICE"; then
    t_started=$(now_ms)
    log "Started in $(seconds $((t_started - t_synced))) s. Waiting until it is $([ "$online" = 1 ] && echo online || echo answering)."
    if wait_healthy "$staged_id" "$online"; then result=installed; fi
  fi
  t_online=$(now_ms)
  t_started=${t_started:-$t_online}

  if [ "$result" = installed ]; then
    rm -f "$STATUS/staged.ready" "$HOST/staged-image" "$HOST/failed-image"
    log "Installed $to in $(seconds $((t_online - t_stop))) s from stop to $([ "$online" = 1 ] && echo online || echo answering), $(seconds $((t_online - REQUEST_MS))) s from the request."
    # The image before the previous one has no use now. A tag or a container that still uses it keeps it.
    if [ -n "$old_previous" ] && [ "$old_previous" != "$running_id" ] && [ "$old_previous" != "$staged_id" ]; then
      "$DOCKER" image rm "$old_previous" >/dev/null 2>&1 || true
    fi
  else
    log "$CONTAINER_NAME did not come back on $to within $HEALTH_TIMEOUT_SECONDS s. Restoring the mirror and $from."
    set_state "$HOST/failed-image" "$staged_id"
    rm -f "$STATUS/staged.ready" "$HOST/staged-image"
    "$DOCKER" stop --time 60 "$CONTAINER_NAME" >/dev/null 2>&1 || true
    if restore_mirror "$data"; then
      log "Restored the data of $stamp from the mirror."
    else
      log "CRITICAL: the restore from the mirror failed. The archive of $stamp follows in $BACKUP_DIR."
    fi
    "$DOCKER" tag "$running_id" "$CURRENT_TAG"
    if compose up -d --pull never "$COMPOSE_SERVICE" && wait_healthy "$running_id" "$online"; then
      log "Back on $from with the data from before the install."
    else
      log "CRITICAL: $from did not come back after the restore."
    fi
    t_online=$(now_ms)
  fi
  phases=$(printf '{"stop":%s,"finalSync":%s,"start":%s,"online":%s}' "$(seconds $((t_stopped - t_stop)))" \
    "$(seconds $((t_synced - t_stopped)))" "$(seconds $((t_started - t_synced)))" "$(seconds $((t_online - t_started)))")
  printf '{"at":"%s","from":"%s","to":"%s","result":"%s","downtimeSeconds":%s,"fromRequestSeconds":%s,"phases":%s,"mirror":"%s"}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$from" "$to" "$result" "$(seconds $((t_online - t_stop)))" \
    "$(seconds $((t_online - REQUEST_MS)))" "$phases" "$stamp" >>"$HOST/installs.log"
  # The archive of the copy from before the install, in the background.
  exec 8>&-
  start_job archive
  [ "$result" = installed ]
}

# True when the staged image can be installed without a new download: staged.ready names it, it is
# still here, the container does not run it, and no install of it failed. The app read staged.ready
# for its update window, so an install of this image installs the build that the window shows. A
# download takes about 1 s even when nothing is new, and the container has stopped its work.
staged_ready() {
  local staged_id running_id
  [ -e "$STATUS/staged.ready" ] || return 1
  staged_id=$(cat "$HOST/staged-image" 2>/dev/null || true)
  running_id=$(container_image)
  [ -n "$staged_id" ] && [ -n "$running_id" ] && [ "$staged_id" != "$running_id" ] || return 1
  [ -n "$(image_id "$staged_id")" ] || return 1
  ! { [ -f "$HOST/failed-image" ] && [ "$(cat "$HOST/failed-image")" = "$staged_id" ]; }
}

# The app writes `update-stage` or `update-install`. It waits while the request is there, then reads
# the state, so the state comes first. The time of the state changes while the request runs.
# `request install` installs without a request file, so the path unit does not take it at the same time.
request() {
  local install=0 result=0 keeper
  REQUEST_MS=$(now_ms)
  lock
  if [ "${1:-}" = install ] || [ -e "$REQUESTS/update-install" ] || [ -L "$REQUESTS/update-install" ]; then install=1; fi
  if [ "$install" -eq 1 ]; then set_state "$STATUS/state" installing; else set_state "$STATUS/state" waiting; fi
  rm -rf -- "$REQUESTS/update-stage" "$REQUESTS/update-install"
  (while sleep 5; do touch -c "$STATUS/state"; done) >/dev/null 2>&1 &
  keeper=$!
  if [ "$install" -eq 1 ] && staged_ready; then
    log "Installing the staged image $(cat "$HOST/staged-image") without a new download."
  else
    (stage $((1 - install))) || result=$?
  fi
  if [ "$install" -eq 1 ]; then
    if [ "$result" -eq 0 ] && [ -e "$STATUS/staged.ready" ]; then
      (install_staged) || result=$?
    else
      # The app stopped its work for the install. Start it again on the same image.
      log "Nothing newer to install. Restarting $CONTAINER_NAME on its image."
      "$DOCKER" restart --time 60 "$CONTAINER_NAME" >/dev/null || result=1
    fi
  fi
  kill "$keeper" 2>/dev/null || true
  rm -f "$STATUS/state"
  return "$result"
}

show_status() {
  read_build "$(labels "$CONTAINER_NAME")"
  echo "running: $BUILD_VERSION ${BUILD_REVISION:-?} ${BUILD_CREATED:-}"
  echo "staged: $(cat "$STATUS/staged.ready" 2>/dev/null || echo none)"
  echo "app updates: $([ -e "$STATUS/enabled" ] && echo enabled || echo disabled)"
  echo "last server state: $(cat "$HOST/server-state" 2>/dev/null || echo unknown)"
  echo "mirror: $(mirror_state | cut -d ' ' -f 1 | grep . || echo none), $(mirror_age) s old ($MIRROR_DATA)"
  if [ -f "$HOST/installs.log" ]; then echo "last install: $(tail -n 1 "$HOST/installs.log")"; fi
  if [ -f "$HOST/archives.log" ]; then echo "last archive: $(tail -n 1 "$HOST/archives.log")"; fi
}

# The host UID:GID of the image user, 1000:1000. With userns-remap, Docker adds the start of the
# ranges of dockremap in /etc/subuid and /etc/subgid.
data_owner() {
  if ! "$DOCKER" info --format '{{.SecurityOptions}}' | grep -q name=userns; then
    echo 1000:1000
    return
  fi
  local uid gid
  uid=$(awk -F: '$1 == "dockremap" { print $2; exit }' /etc/subuid)
  gid=$(awk -F: '$1 == "dockremap" { print $2; exit }' /etc/subgid)
  [ -n "$uid" ] && [ -n "$gid" ] || fail "Docker uses userns-remap, but dockremap has no range."
  echo "$((uid + 1000)):$((gid + 1000))"
}

# Sets KEY=VALUE in env file $1, and keeps its other lines.
set_env_line() {
  local file=$1 key=$2 value=$3
  touch "$file"
  grep -v "^$key=" "$file" >"$file.new" || true
  printf '%s=%s\n' "$key" "$value" >>"$file.new"
  chmod --reference="$file" "$file.new"
  mv -f "$file.new" "$file"
}

setup() {
  local here recreate=0 stamp saved owner files running_id unit
  [ "$(id -u)" -eq 0 ] || fail "Run setup as root."
  command -v rsync >/dev/null || fail "rsync is not installed. Run 'apt-get install rsync' first."
  for arg in "$@"; do
    case $arg in
      --recreate) recreate=1 ;;
      *) fail "Unknown option $arg." ;;
    esac
  done
  here=$(dirname "$(readlink -f "$0")")
  for unit in openbot-vps-update.path openbot-vps-update.service openbot-vps-update-stage.service \
    openbot-vps-update-stage.timer compose.update.yaml; do
    [ -f "$here/$unit" ] || fail "$here/$unit is missing. Run setup from the docker/vps-update folder."
  done
  [ -f "$STACK_DIR/compose.yaml" ] || fail "There is no $STACK_DIR/compose.yaml."

  if [ ! -f "$CONFIG" ]; then
    printf '%s\n' "# openbot-vps-update settings. See docs/docker.md#updates-from-the-app-on-a-vps-pokebots." \
      "STACK_DIR=$STACK_DIR" "COMPOSE_SERVICE=$COMPOSE_SERVICE" "CONTAINER_NAME=$CONTAINER_NAME" \
      "IMAGE_REF=$IMAGE_REF" "BACKUP_DIR=$BACKUP_DIR" "BACKUP_NAME=$BACKUP_NAME" "BACKUP_KEEP=$BACKUP_KEEP" >"$CONFIG"
    chmod 0644 "$CONFIG"
  fi

  # A copy of what setup changes, so that it can be undone.
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  saved=$UPDATE_DIR/setup-backups/$stamp
  install -d -m 0700 "$saved"
  for files in "$STACK_DIR"/compose*.yaml "$STACK_DIR/.env" "$UNIT_DIRECTORY"/openbot-vps-auto-update.* \
    /usr/local/bin/openbot-vps-auto-update /etc/fstab; do
    if [ -e "$files" ]; then cp -a -- "$files" "$saved/"; fi
  done
  if [ -d "$UNIT_DIRECTORY/openbot-vps-auto-update.timer.d" ]; then
    cp -a -- "$UNIT_DIRECTORY/openbot-vps-auto-update.timer.d" "$saved/"
  fi
  log "Saved the old files in $saved."

  # The automatic swap of docker/vps-auto-update.sh, which this replaces.
  if [ -e "$UNIT_DIRECTORY/openbot-vps-auto-update.timer" ]; then
    systemctl disable --now openbot-vps-auto-update.timer >/dev/null 2>&1 || true
    rm -rf -- "$UNIT_DIRECTORY"/openbot-vps-auto-update.timer "$UNIT_DIRECTORY"/openbot-vps-auto-update.service \
      "$UNIT_DIRECTORY/openbot-vps-auto-update.timer.d" /usr/local/bin/openbot-vps-auto-update
    log "Removed the automatic swap (openbot-vps-auto-update)."
  fi

  install -m 0755 "$here/openbot-vps-update" "$INSTALLED"
  install -d -m 0755 "$UPDATE_DIR" "$STATUS"
  install -d -m 0700 "$HOST"
  # The container writes requests. The folder is a small tmpfs, so it cannot fill the disk. Docker
  # would make a missing folder as root, and the container could not write to it.
  owner=$(data_owner)
  install -d -m 0700 "$REQUESTS"
  if ! grep -qF " $REQUESTS tmpfs " /etc/fstab; then
    printf 'tmpfs %s tmpfs size=64k,nr_inodes=16,mode=0700,uid=%s,gid=%s,nodev,nosuid,noexec,nofail,x-systemd.before=docker.service 0 0\n' \
      "$REQUESTS" "${owner%:*}" "${owner#*:}" >>/etc/fstab
    systemctl daemon-reload
  fi
  mountpoint -q "$REQUESTS" || mount "$REQUESTS"
  # OpenBot offers updates from the app only when this file is there.
  touch "$STATUS/enabled"
  chmod 0644 "$STATUS/enabled"

  for unit in openbot-vps-update.path openbot-vps-update.service openbot-vps-update-stage.service \
    openbot-vps-update-stage.timer; do
    install -m 0644 "$here/$unit" "$UNIT_DIRECTORY/$unit"
  done
  install -m 0644 "$here/compose.update.yaml" "$STACK_DIR/compose.update.yaml"
  files=compose.yaml
  if [ -f "$STACK_DIR/compose.override.yaml" ]; then files=$files:compose.override.yaml; fi
  set_env_line "$STACK_DIR/.env" COMPOSE_FILE "$files:compose.update.yaml"
  chown --reference="$STACK_DIR/compose.yaml" "$STACK_DIR/compose.update.yaml" "$STACK_DIR/.env"

  # The running image becomes openbot-vps:current, so the next `up` keeps it.
  running_id=$(container_image)
  if [ -n "$running_id" ] && [ -z "$(image_id "$CURRENT_TAG")" ]; then "$DOCKER" tag "$running_id" "$CURRENT_TAG"; fi
  [ -n "$(image_id "$CURRENT_TAG")" ] || "$DOCKER" tag "$IMAGE_REF" "$CURRENT_TAG"
  check_compose

  systemctl daemon-reload
  systemctl enable --now openbot-vps-update.path openbot-vps-update-stage.timer
  log "Installed. The timer stages new images; Install in Server Settings > Updates installs them."
  if [ "$recreate" -eq 1 ]; then
    log "Making $CONTAINER_NAME again once, with the update folders. Clients reconnect."
    local stopped_at=$SECONDS online=0
    if [ "$(status_value "$(read_status)" server)" = online ]; then online=1; fi
    compose up -d "$COMPOSE_SERVICE"
    wait_healthy "$(image_id "$CURRENT_TAG")" "$online" || fail "$CONTAINER_NAME did not come back."
    log "$CONTAINER_NAME is back after $((SECONDS - stopped_at)) s."
  else
    log "Run 'cd $STACK_DIR && docker compose up -d' once to give the container the update folders, when it does not have them."
  fi
  # The first copy to the mirror takes minutes on a large volume, so it starts now while the server
  # runs. Later copies take only the changes.
  SELF=$INSTALLED
  if container_running && mirror_stale; then
    start_job precopy
    log "Started the pre-copy to $MIRROR_DATA in the background."
  fi
}

main() {
  local command=${1:-}
  [ "$#" -eq 0 ] || shift
  case $command in
    setup) setup "$@" ;;
    stage)
      lock
      stage
      ;;
    request) request ;;
    install) request install ;;
    precopy) precopy_job ;;
    archive) archive_job ;;
    status) show_status ;;
    *)
      sed -n '2,35p' "$0" | sed 's/^# \{0,1\}//'
      [ -z "$command" ] || exit 2
      ;;
  esac
}

main "$@"

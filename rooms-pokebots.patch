+
+
+POKEBOTS_ISSUER = "urn:pokebots:integrations"
+POKEBOTS_SUBJECT = re.compile(r"pokebots:[A-Za-z0-9_-]{1,128}")
+WORKOS_SUBJECT = re.compile(r"user_[a-zA-Z0-9]+")
+
+
+def claims_pokebots_issuer(token: str) -> bool:
+    try:
+        claims = jwt.decode(token, options={"verify_signature": False})
+    except (jwt.PyJWTError, ValueError):
+        return False
+    return claims.get("iss") == POKEBOTS_ISSUER
+
+
+class IntegrationVerifier(TokenVerifier):
+    def __init__(self, legacy: TokenVerifier, public_pem: str):
+        super().__init__()
+        self.legacy = legacy
+        self.key: RSAPublicKey | None = None
+        if public_pem.strip():
+            try:
+                key = load_pem_public_key(public_pem.replace("\\n", "\n").strip().encode())
+            except ValueError:
+                raise SystemExit("Invalid POKEBOTS_INTEGRATION_PUBLIC_KEY") from None
+            if not isinstance(key, RSAPublicKey):
+                raise SystemExit("POKEBOTS_INTEGRATION_PUBLIC_KEY must be an RSA public key")
+            self.key = key
+
+    async def verify_token(self, token: str) -> AccessToken | None:
+        if not claims_pokebots_issuer(token):
+            return await self.legacy.verify_token(token)
+        if self.key is None:
+            return None
+        try:
+            claims = jwt.decode(
+                token,
+                self.key,
+                algorithms=["RS256"],
+                issuer=POKEBOTS_ISSUER,
+                audience="rooms",
+                options={
+                    "require": ["iss", "aud", "sub", "iat", "exp", "scope"],
+                    "strict_aud": True,
+                    "verify_iat": False,
+                    "verify_exp": False,
+                },
+            )
+        except (jwt.PyJWTError, ValueError, TypeError, OverflowError):
+            return None
+
+        sub, iat, exp = claims["sub"], claims["iat"], claims["exp"]
+        if (
+            not isinstance(sub, str)
+            or not POKEBOTS_SUBJECT.fullmatch(sub)
+            or claims["scope"] != "integration:use"
+            or type(iat) is not int
+            or type(exp) is not int
+            or not 0 <= iat <= time.time() < exp <= (1 << 53) - 1
+            or exp - iat > 300
+        ):
+            return None
+
+        linked = claims.get("linked_workos_sub")
+        if "linked_workos_sub" in claims:
+            if (
+                not isinstance(linked, str)
+                or not WORKOS_SUBJECT.fullmatch(linked)
+                or not isinstance(self.legacy, WorkOSUserVerifier)
+            ):
+                return None
+            identity = await self.legacy.lookup(linked)
+            if identity is None:
+                return None
+        else:
+            identity = {"sub": sub, "email": "", "name": "Pokebots user"}
+
+        return AccessToken(
+            token=token,
+            client_id="pokebots",
+            scopes=["integration:use"],
+            expires_at=exp,
+            claims=identity,
+        )
+
+
+def user_verifier(settings: Settings) -> TokenVerifier:
+    return IntegrationVerifier(legacy_user_verifier(settings), settings.pokebots_integration_public_key)
 
 

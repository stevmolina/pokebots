diff --git a/tests/test_pokebots_integration.py b/tests/test_pokebots_integration.py
new file mode 100644
--- /dev/null
+++ b/tests/test_pokebots_integration.py
@@ -0,0 +1,82 @@
+from __future__ import annotations
+
+import time
+
+import httpx
+import jwt
+from fastmcp import Client
+from fastmcp.client.auth import BearerAuth
+from fastmcp.server.auth.providers.jwt import RSAKeyPair
+
+from conftest import _free_port, run_live
+from rooms import auth
+from rooms.config import Settings
+from test_wake_and_auth import AUD, ISS, _jwt_setup
+
+
+async def test_pokebots_rest_and_mcp(tmp_path, monkeypatch):
+    integration_keys = RSAKeyPair.generate()
+    workos_keys, _, workos, lookups = _jwt_setup()
+    monkeypatch.setattr(auth, "legacy_user_verifier", lambda _: workos)
+    port = _free_port()
+    settings = Settings(
+        base_url=f"http://127.0.0.1:{port}",
+        authkit_domain=ISS,
+        db_path=str(tmp_path / "rooms.db"),
+        pokebots_integration_public_key=integration_keys.public_key.replace("\n", "\\n"),
+    )
+    now = int(time.time())
+    issuer = "urn:pokebots:integrations"
+    subject = "pokebots:account_1"
+
+    def token(**overrides):
+        claims = dict(
+            iss=issuer, aud="rooms", sub=subject, iat=now, exp=now + 120,
+            scope="integration:use", email="ana@example.com",
+        )
+        claims.update(overrides)
+        return jwt.encode(claims, integration_keys.private_key.get_secret_value(), algorithm="RS256")
+
+    with run_live(settings, port) as live:
+        async with httpx.AsyncClient(base_url=live.url + "/api/v1") as rest:
+            workos_token = workos_keys.create_token(subject="user_01", issuer=ISS, audience=AUD)
+            rest.headers["Authorization"] = f"Bearer {workos_token}"
+            legacy = await rest.post("/rooms", json={"name": "Legacy room"})
+            assert legacy.status_code == 200
+            legacy_id = legacy.json()["room"]["id"]
+            store = live.app.store
+            store.ensure_user("user_owner", "owner@example.com", "Owner")
+            invite_room = store.create_room("user_owner", "Invite room")
+            store.invite_email("user_owner", invite_room["id"], "ana@example.com")
+            native_token = token()
+            rest.headers["Authorization"] = f"Bearer {native_token}"
+            native = await rest.post("/rooms", json={"name": "Native room"})
+            assert native.status_code == 200
+            native_id = native.json()["room"]["id"]
+            assert (await rest.get(f"/rooms/{native_id}")).status_code == 200
+            assert (await rest.get(f"/rooms/{legacy_id}")).status_code == 404
+            assert live.app.store.my_email_invites(subject) == []
+            assert live.app.store.get_user(subject)["email"] == ""
+
+            async with Client(live.url + "/mcp", auth=BearerAuth(native_token)) as mcp:
+                listing = await mcp.call_tool("rooms_list")
+                assert [room["id"] for room in listing.structured_content["rooms"]] == [native_id]
+
+            linked = token(linked_workos_sub="user_01")
+            rest.headers["Authorization"] = f"Bearer {linked}"
+            assert (await rest.get(f"/rooms/{legacy_id}")).status_code == 200
+            assert (await rest.get(f"/rooms/{native_id}")).status_code == 404
+            async with Client(live.url + "/mcp", auth=BearerAuth(linked)) as mcp:
+                listing = await mcp.call_tool("rooms_list")
+                assert [room["id"] for room in listing.structured_content["rooms"]] == [legacy_id]
+
+            for bad in [
+                token(aud="other"), token(aud=["rooms"]), token(iss="other"),
+                token(sub="user_01"), token(iat=True), token(iat=now + 60),
+                token(exp=str(now + 120)), token(exp=now + 301), token(exp=now),
+                token(scope="integration:use extra"), token(linked_workos_sub="user_bad-id"),
+                jwt.encode({"iss": issuer}, "test-key" * 5, algorithm="HS256"),
+            ]:
+                rest.headers["Authorization"] = f"Bearer {bad}"
+                assert (await rest.get("/rooms")).status_code == 401
+            assert len(lookups) == 1
